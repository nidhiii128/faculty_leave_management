# Clean Ubuntu 22.04 VM to prove provisioning from scratch (Task 14).
#   vagrant up        # creates the VM
#   cd .. && ansible-playbook -i ansible/inventory.ini ansible/site.yml -l vm
Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.hostname = "flms-target"
  config.vm.network "private_network", ip: "192.168.56.20"
  config.vm.provider "virtualbox" do |vb|
    vb.memory = 2048
    vb.cpus = 2
  end
end
